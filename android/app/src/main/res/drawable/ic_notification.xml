<!--
    通知バーの小さなアイコン（PushNotificationManager が参照）。
    chatoki.jpg の「吹き出し＋時計」マークを白のシルエットで 24dp に描き直したもの。
    通知の小さいアイコンはアルファチャンネルのみ使われるため、
    塗り色を白にしておくとシステムが 자동으로着色する。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 吹き出しの尾 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M4.2,15.4L3.1,20.9L7.4,18.0Z" />
    <!-- 吹き出しの本体: 外周と内周を evenOdd で描いて輪にする -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,2.2m-9.8,0a9.8,9.8 0 1,0 19.6,0a9.8,9.8 0 1,0 -19.6,0 M12,4.6m-7.4,0a7.4,7.4 0 1,0 14.8,0a7.4,7.4 0 1,0 -14.8,0" />
    <!-- 文字盤の目盛り（12時/3時/6時/9時） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M11.2,6.6h1.6v1.9h-1.6z M16.9,11.2h1.9v1.6h-1.9z M11.2,15.9h1.6v1.9h-1.6z M5.2,11.2h1.9v1.6h-1.9z" />
    <!-- 針（短針=上、長針=右下） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M11.25,7.6h1.5v6.1h-1.5z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M11.6,11.4h1.5v1.5h-1.5z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12.6,12.5l4.0,2.6l-0.8,1.2l-4.0,-2.6z" />
