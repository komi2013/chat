    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@skyway-sdk/room": "^2.2.0",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "pinia": "^2.1.6",
    "quill": "^2.0.3",
    "quill-mention": "^5.0.0",
    "turndown": "^7.2.4",
    "vue": "^3.3.4",
    "vue-qrcode": "^2.2.0",
    "vue-router": "^4.2.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/vue": "^7.0.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^8.49.0",
    "eslint-plugin-vue": "^9.17.0",
    "jsdom": "^23.0.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
