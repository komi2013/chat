package controller

import (
	"context"
	"encoding/json"
	"fmt"
	"log"
	"net/http"
	"time"

	"go.mongodb.org/mongo-driver/bson"
	"go.mongodb.org/mongo-driver/mongo"
	"go.mongodb.org/mongo-driver/mongo/options"

  "chat/collection"
  "chat/common"
)

// BookAdd adds a booking if the conditions are met
func BookAdd(w http.ResponseWriter, r *http.Request) {
	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()
	c, err := mongo.Connect(ctx, options.Client().ApplyURI(common.Mongo1))
	if err != nil {
		log.Print(err)
	}
	defer c.Disconnect(ctx)
	db1 := c.Database(common.MongoDb1)

	// Fetch the specified window document based on windowID
	windowID := r.FormValue("windowID")
	windowColl := db1.Collection("window")
	var windowDoc collection.WindowStruct
	err = windowColl.FindOne(ctx, bson.M{"_id": windowID}).Decode(&windowDoc)
	if err != nil {
		http.Error(w, "Window not found", http.StatusNotFound)
		return
	}

	// Get all existing bookings for the window to check requirements
	bookColl := db1.Collection("book")
	bookFilter := bson.M{"window_id": windowID}
	cursor, err := bookColl.Find(ctx, bookFilter)
	if err != nil {
		fmt.Printf("book find err %s\n", err)
		http.Error(w, "Error finding books", http.StatusInternalServerError)
		return
	}
	var books []collection.BookStruct
	if err = cursor.All(ctx, &books); err != nil {
		fmt.Printf("book all err %s\n", err)
		return
	}

	// Fetch the requested `menuID` and book start/end times from the request
	menuID := r.FormValue("menuID")
	bookStart := r.FormValue("book_start")
	bookEnd := r.FormValue("book_end")

	// Find the corresponding menu entry in the window document
	var selectedMenu collection.MenuStruct
	for _, menu := range windowDoc.Menu {
		if menu.Name == menuID {
			selectedMenu = menu
			break
		}
	}

	// Check if the required facilities and roles are met
	needRole := selectedMenu.NeedRole
	needFacility := selectedMenu.NeedFacility
	isAvailable := true

	for _, timeSlot := range windowDoc.Times {
		if timeSlot.LimitStart == bookStart && timeSlot.LimitEnd == bookEnd {
			// Check if required facilities and roles are available
			for _, booking := range books {
				if booking.UseRole == needRole {
					isAvailable = false
					break
				}
				if booking.UseFacility == needFacility {
					isAvailable = false
					break
				}
			}
		}
	}

	// Insert the booking if available
	if isAvailable {
		book := collection.BookStruct{
			ID:          primitive.NewObjectID(),
			WindowID:    windowID,
			BookStart:   bookStart,
			BookEnd:     bookEnd,
			Answers:     r.FormValue("answers"),
			MenuID:      menuID,
			UseRole:     needRole,
			UseFacility: needFacility,
		}

		_, err := bookColl.InsertOne(ctx, book)
		if err != nil {
			http.Error(w, "Failed to insert booking", http.StatusInternalServerError)
			return
		}
	} else {
		http.Error(w, "Facilities or roles not available", http.StatusConflict)
		return
	}

	w.WriteHeader(http.StatusOK)
	w.Header().Set("Content-Type", "application/json")
	if err := json.NewEncoder(w).Encode(books); err != nil {
		http.Error(w, "Failed to encode books to JSON", http.StatusInternalServerError)
	}
}
